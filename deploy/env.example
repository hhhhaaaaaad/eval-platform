# =============================================================================
# 记忆系统独立评测平台 —— 环境变量模板
# -----------------------------------------------------------------------------
# 用法：复制为 deploy/.env 后按需修改。
#   Git Bash / Linux / macOS : cp deploy/env.example deploy/.env
#   Windows CMD              : copy deploy\env.example deploy\.env
#   PowerShell               : Copy-Item deploy\env.example deploy\.env
#
# 本文件是「模板」，会提交入库；deploy/.env 已被 .gitignore 忽略。
# 切勿把任何真实密钥 / 生产口令写进本文件。
# =============================================================================

# ---------------------------------------------------------------------------
# 运行环境
# ---------------------------------------------------------------------------
# 运行环境标识：local / staging / production。影响日志、调试等默认行为。
ENVIRONMENT=local
# 调试开关。本地排障可临时置 true；生产必须 false（否则会泄露堆栈细节）。
DEBUG=false
# HTTP 服务监听地址与端口。API_PORT 需与 compose 端口映射 8093:8093 保持一致。
API_HOST=0.0.0.0
API_PORT=8093

# ---------------------------------------------------------------------------
# 平台自身存储（与 AgentWrite 物理隔离，端口刻意错开，勿指向 AgentWrite 的库）
# ---------------------------------------------------------------------------
# 平台元数据库：用户 / 数据集 / run / 结果。宿主端口 15432。
# 注意：此处 localhost 面向「在宿主机直接跑 API」的场景；
#       容器内由 docker-compose.yml 覆盖为 eval-postgres:5432。
DATABASE_URL=postgresql+psycopg://eval:eval@localhost:15432/eval_platform
# Celery broker + result backend。宿主端口 16380（勿用 AgentWrite 的 Redis 16379）。
# 容器内由 docker-compose.yml 覆盖为 eval-redis:6379。
REDIS_URL=redis://localhost:16380/0

# ---------------------------------------------------------------------------
# AgentWrite（Java）评测端点 —— 仅通过 HTTP 调用，不直连其数据库
# ---------------------------------------------------------------------------
# AgentWrite 后端基址，对应其 /api/v1/eval/** 端点。
JAVA_EVAL_BASE_URL=http://localhost:8092
# 调用 AgentWrite eval 端点所需令牌：需填入拥有 ROLE_EVAL 权限的 JWT。
# 本地默认留空；从 AgentWrite 侧登录取到该令牌后填入。
JAVA_EVAL_TOKEN=
# 单次调用超时（秒）。评测链路调用 LLM 较慢，默认 30s。
JAVA_EVAL_TIMEOUT_SECONDS=30
# 失败重试次数（默认 3）。
JAVA_EVAL_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# 安全
# ---------------------------------------------------------------------------
# 平台自身签发用户会话的 JWT 签名密钥。
# !!! 生产环境必须覆盖为高强度随机值 !!! 本地占位值切勿在 staging/production 复用。
# 生成示例：openssl rand -hex 32
JWT_SECRET=dev-only-change-me

# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
# 日志级别：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO
# 结构化 JSON 日志：true 便于集中采集，false 便于本地肉眼阅读。
LOG_JSON=true

# ---------------------------------------------------------------------------
# Flower（Celery 监控面板）HTTP Basic Auth 凭据
# ---------------------------------------------------------------------------
# 生产环境必须改为强口令；默认 eval/eval 仅供本地开发。
FLOWER_USER=eval
FLOWER_PASSWORD=eval
